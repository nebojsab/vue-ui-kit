{
  "name": "@nebojsab/vue-ui-kit",
  "version": "2.0.0",
  "description": "Vue 3 UI kit — design tokens, Tailwind preset, components and art, light and dark",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nebojsab/vue-ui-kit.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./tailwind-v4.css": "./tailwind-v4.css",
    "./tailwind-preset": {
      "types": "./tailwind-preset.d.ts",
      "default": "./tailwind-preset.js"
    },
    "./logo/*": "./src/logo/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "tailwind-preset.js",
    "tailwind-preset.d.ts",
    "tailwind-v4.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build:docs": "vite build",
    "build:docs:pages": "vite build && node scripts/prerender-meta.mjs",
    "og": "node scripts/shoot.mjs scripts/og/og.html docs/public/og.png 1280 640 1",
    "build:types": "node scripts/gen-types.mjs",
    "prepublishOnly": "node scripts/gen-types.mjs"
  },
  "peerDependencies": {
    "@heroicons/vue": "^2.2.0",
    "tailwindcss": "^3.4.0 || ^4.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8"
  },
  "devDependencies": {
    "@heroicons/vue": "^2.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "homepage": "https://nebojsab.github.io/vue-ui-kit/",
  "keywords": [
    "vue",
    "vue3",
    "vue-components",
    "tailwindcss",
    "tailwind",
    "component-library",
    "design-system",
    "ui-kit",
    "dark-mode",
    "theming",
    "accessibility"
  ],
  "author": "Nebojsa Brnjasevic",
  "bugs": {
    "url": "https://github.com/nebojsab/vue-ui-kit/issues"
  },
  "types": "./src/index.d.ts",
  "main": "./src/index.js"
}

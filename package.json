{
  "name": "@nebojsab/vue-ui-kit",
  "version": "1.0.0",
  "description": "Vue 3 UI kit — design tokens, Tailwind preset, components and art, light and dark",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nebojsab/vue-ui-kit.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./styles.css": "./src/styles/index.css",
    "./tailwind-preset": "./tailwind-preset.js",
    "./logo/*": "./src/logo/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "tailwind-preset.js"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build:docs": "vite build",
    "build:docs:pages": "vite build && cp docs-dist/index.html docs-dist/404.html"
  },
  "peerDependencies": {
    "@heroicons/vue": "^2.2.0",
    "tailwindcss": "^3.4.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8"
  },
  "devDependencies": {
    "@heroicons/vue": "^2.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "homepage": "https://nebojsab.github.io/vue-ui-kit/"
}
